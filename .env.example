# ============================================================
# FreeChess — variables de entorno de ejemplo
# Copia este archivo a .env y rellena los valores.
# NUNCA subas el archivo .env real a git.
# ============================================================

# Conexión a la base de datos Neon PostgreSQL (solo servidor).
# La obtienes del panel de Neon: Project Dashboard -> Connection string.
# Con la integración Neon-Vercel esta variable se inyecta automáticamente
# en Vercel con el nombre DATABASE_URL.
DATABASE_URL="postgresql://usuario:contrasena@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar sesiones de Better Auth (solo servidor).
# Genera uno nuevo con:  openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (necesaria para correos y redirecciones de auth).
# En desarrollo: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# URL pública de la app para uso general (PWA, metadatos).
PUBLIC_APP_URL="http://localhost:3000"
