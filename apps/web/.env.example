# Variables de entorno de la aplicación web (apps/web).
# Copia este archivo a apps/web/.env para desarrollo local.
# En Vercel: DATABASE_URL la inyecta la integración de Neon;
# BETTER_AUTH_SECRET y PUBLIC_APP_URL se configuran en el panel de Vercel.

# Conexión a Neon PostgreSQL (solo servidor).
DATABASE_URL="postgresql://usuario:contrasena@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar sesiones (solo servidor).
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (redirecciones y metadatos).
PUBLIC_APP_URL="http://localhost:3000"
